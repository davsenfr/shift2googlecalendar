# OAuth 2.0 — client de type « Application Web » dans Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# "primary" utilise l'agenda principal du compte connecté.
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=Europe/Paris

API_PORT=3000
WEB_URL=http://localhost:5173

# En production, placez ce fichier sur un volume persistant et chiffré.
GOOGLE_TOKEN_PATH=.data/google-tokens.json
