# OAuth 2.0 client of type "Web application" in Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# "primary" uses the connected account's primary calendar.
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=Europe/Paris

API_PORT=3001
WEB_URL=http://localhost:5173

# The browser uses /api; Vite forwards it to this target during development.
VITE_API_BASE_URL=/api
VITE_API_TARGET=http://localhost:3001

# Keep this file on persistent, encrypted storage in production.
GOOGLE_TOKEN_PATH=.data/google-tokens.json
